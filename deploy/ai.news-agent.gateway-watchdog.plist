<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.news-agent.gateway-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/apple/News-Agent/scripts/gateway_watchdog.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/apple/News-Agent/logs/gateway-watchdog-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apple/News-Agent/logs/gateway-watchdog-launchd.log</string>
</dict>
</plist>
